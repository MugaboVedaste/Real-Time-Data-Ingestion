POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ecommerce_streaming
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password

# Optional
# Windows only: folder that contains bin\winutils.exe (default D:\hadoop)
# HADOOP_HOME=D:\hadoop
# Files Spark reads per micro-batch (default 10) and trigger interval
# MAX_FILES_PER_TRIGGER=10
# TRIGGER_INTERVAL=5 seconds
